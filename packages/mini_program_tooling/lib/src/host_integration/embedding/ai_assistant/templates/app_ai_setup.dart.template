import 'ai/host_ai.dart';

/// Host-owned configuration. Tooling never overwrites this file, even --force.
/// Connect your own authenticated AI server/model here. Only the main host
/// creates model clients; mini-program tasks share its session and controls.
HostAiSettings buildHostAiSettings() => const HostAiSettings(
  modelFactory: unconfiguredHostAiModel,
  bubbleStyle: HostAiBubbleStyle(label: 'AI assistant'),
);

